# the API this site talks to
NEXT_PUBLIC_API_URL=https://api.idelta.com.au
# comma-separated hosts allowed to reach the dev server through a proxy
DEV_ORIGINS=idelta.com.au

# Feature 2001 -- the contractor address field (Google Places). A browser
# key, restricted to this site's referrers; see project/setup/
# 01-dev-environment.md section 6 and 03-prod-environment.md section 5.
# LEAVE IT EMPTY IN DEV until that one-time act is done: the address field
# degrades to its unavailable state (disabled, warning line) and the rest of
# the screen still saves -- no fallback needed, this is never a required var.
NEXT_PUBLIC_GOOGLE_PLACES_KEY=
